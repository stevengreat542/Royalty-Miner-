rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.id is string
        && data.id == request.auth.uid
        && data.id.size() <= 128
        && data.email is string
        && data.email.size() <= 128
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 64))
        && data.createdAt is string
        && (!('updatedAt' in data) || data.updatedAt is string);
    }

    // User profile documents (isolated to authenticated document owner)
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if false;
    }
  }
}
